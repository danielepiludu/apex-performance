rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Ogni account legge e scrive solo i propri dati: users/<il suo id>/...
    // e solo se la sua email è nell'elenco degli account autorizzati.
    // L'elenco vero sta solo nella console Firebase (qui un esempio, il repository è pubblico).
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid
        && request.auth.token.email in ['tua.email@gmail.com'];
    }
  }
}
